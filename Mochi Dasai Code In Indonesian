void updateTime() {
  if (millis() - lastTimeUpdate >= 1000) { 
    lastTimeUpdate = millis();
    if (isOnline) { time_t now; struct tm timeinfo; time(&now); localtime_r(&now, &timeinfo); if (timeinfo.tm_year > 70) { currentHour = timeinfo.tm_hour; currentMin = timeinfo.tm_min; } } 
    else { if (millis() - lastOfflineSec >= 60000) { lastOfflineSec = millis(); currentMin++; if (currentMin >= 60) { currentMin = 0; currentHour = (currentHour + 1) % 24; } } }
  }
}

void fetchWeather() {
  if (!isOnline || WiFi.status() != WL_CONNECTED) return;
  HTTPClient http; http.setTimeout(1500); String weatherUrl = "http://api.open-meteo.com/v1/forecast?latitude=" + String(currentLat, 4) + "&longitude=" + String(currentLon, 4) + "&current_weather=true";
  if (http.begin(weatherUrl)) { if (http.GET() == HTTP_CODE_OK) {
      String payload = http.getString();
      int tempIdx = payload.indexOf("\"temperature\":");
      if (tempIdx != -1) { int commaIdx = payload.indexOf(",", tempIdx); currentTemp = payload.substring(tempIdx + 14, commaIdx).toInt(); }
      int codeIdx = payload.indexOf("\"weathercode\":");
      if (codeIdx != -1) { int commaIdx = payload.indexOf("}", codeIdx); int code = payload.substring(codeIdx + 14, commaIdx).toInt(); weatherDesc = (code == 0) ? "Clear" : (code <= 3) ? "Cloudy" : "Rain"; }
    } http.end(); }
}


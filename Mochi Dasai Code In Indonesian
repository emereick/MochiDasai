void enterDeepSleep() { 
  saveEvolutionData(); 
  display.clearDisplay(); 
  safeDisplayRender(); 
  digitalWrite(LED_PIN, LOW); 
  esp_deep_sleep_enable_gpio_wakeup(1ULL << BUTTON1_PIN, ESP_GPIO_WAKEUP_GPIO_LOW); 
  esp_deep_sleep_start(); 
}


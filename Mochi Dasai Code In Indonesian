// INISIALISASI I2C KHUSUS C3: SDA=8, SCL=9
bool initOLED() { Wire.begin(8, 9); Wire.setClock(100000); return display.begin(SSD1306_SWITCHCAPVCC, 0x3C) || display.begin(SSD1306_SWITCHCAPVCC, 0x3D); }
void safeDisplayRender() { Wire.beginTransmission(0x3C); if (Wire.endTransmission() != 0) { Wire.beginTransmission(0x3D); if (Wire.endTransmission() != 0) initOLED(); } display.display(); }
void checkNightMode() { display.ssd1306_command(SSD1306_SETCONTRAST); display.ssd1306_command((currentHour >= 22 || currentHour < 5) ? 15 : 255); }

void playSound(String type) {
  ledcWrite(BUZZER_PIN, 1024);
  if (type == "HAPPY") { ledcWriteTone(BUZZER_PIN, 523); delay(80); ledcWriteTone(BUZZER_PIN, 659); delay(100); } 
  else if (type == "HUNGRY" || type == "SICK") { ledcWriteTone(BUZZER_PIN, 300); delay(120); ledcWriteTone(BUZZER_PIN, 220); delay(150); } 
  else if (type == "SLEEP") { ledcWriteTone(BUZZER_PIN, 300); delay(150); ledcWriteTone(BUZZER_PIN, 150); delay(300); } 
  else if (type == "WAKE") { ledcWriteTone(BUZZER_PIN, 220); delay(80); ledcWriteTone(BUZZER_PIN, 440); delay(80); ledcWriteTone(BUZZER_PIN, 880); delay(100); } 
  else if (type == "LEVELUP") { ledcWriteTone(BUZZER_PIN, 440); delay(100); ledcWriteTone(BUZZER_PIN, 554); delay(100); ledcWriteTone(BUZZER_PIN, 659); delay(200); } 
  else if (type == "JUMP") { ledcWriteTone(BUZZER_PIN, 700); delay(35); } 
  else if (type == "GAMEOVER") { ledcWriteTone(BUZZER_PIN, 180); delay(250); }
  else if (type == "BEEP") { ledcWriteTone(BUZZER_PIN, 2000); delay(50); }
  else if (type == "ALARM") { ledcWriteTone(BUZZER_PIN, 1000); delay(150); ledcWriteTone(BUZZER_PIN, 1500); delay(150); ledcWriteTone(BUZZER_PIN, 1000); delay(150); }
  ledcWrite(BUZZER_PIN, 0); 
}


    else { pomodoroIsBreak = !pomodoroIsBreak; pomodoroSecondsLeft = pomodoroIsBreak ? 300 : 1500; playSound("LEVELUP"); if (!pomodoroIsBreak) { currentEXP += 50; saveEvolutionData(); checkEvolution(); } }
  }
}

void updateGameLogic() {
  if (currentAppMode != MODE_GAME || (!gameActive && !gameOver)) return;
  if (gameActive) {
    petY += petVY; petVY += gravity; if (petY >= 38) { petY = 38; petVY = 0; }
    obstacleX -= (3 + (gameScore / 4));
    if (obstacleX < -obstacleWidth) { obstacleX = 128; gameScore++; playSound("HAPPY"); }
    if (obstacleX < 28 && (obstacleX + obstacleWidth) > 16 && petY >= (50 - obstacleHeight)) {
      gameActive = false; gameOver = true; playSound("GAMEOVER");
      if (gameScore > highScore) highScore = gameScore; currentEXP += gameScore * 2; saveEvolutionData(); checkEvolution();
    }
  }
}

void resetPongBall() { pongBX = 64; pongBY = 32; pongBDX = (random(0,2)==0) ? 2.5 : -2.5; pongBDY = (random(0,2)==0) ? 1.5 : -1.5; }

void updatePongLogic() {
  if (currentAppMode != MODE_PONG) return;
  if (pongPlayerMovingUp) pongPlayerY -= 2; else pongPlayerY += 2;
  if (pongPlayerY < 0) pongPlayerY = 0; if (pongPlayerY > 48) pongPlayerY = 48; 
  if (pongBX > 64 && pongBDX > 0) { if (pongAiY + 8 < pongBY) pongAiY += 2; else if (pongAiY + 8 > pongBY) pongAiY -= 2; }
  if (pongAiY < 0) pongAiY = 0; if (pongAiY > 48) pongAiY = 48;
  pongBX += pongBDX; pongBY += pongBDY;
  if (pongBY <= 0 || pongBY >= 60) { pongBDY = -pongBDY; playSound("BEEP"); }
  if (pongBX <= 4 && pongBX >= 2) { if (pongBY + 4 >= pongPlayerY && pongBY <= pongPlayerY + 16) { pongBDX = -pongBDX; pongBX = 5; playSound("JUMP"); } }
  if (pongBX >= 120 && pongBX <= 122) { if (pongBY + 4 >= pongAiY && pongBY <= pongAiY + 16) { pongBDX = -pongBDX; pongBX = 119; playSound("JUMP"); } }
  if (pongBX < 0) { pongScoreAI++; resetPongBall(); playSound("GAMEOVER"); delay(500); }
  if (pongBX > 128) { pongScoreP++; currentEXP += 5; saveEvolutionData(); checkEvolution(); resetPongBall(); playSound("HAPPY"); delay(500); }
}

void handleButtons() {
  unsigned long now = millis();
  
  // --- TOMBOL 1 (ACTION) ---
  int b1State = digitalRead(BUTTON1_PIN);
  if (b1State == LOW) {
    if (!isB1Pressed) {
      isB1Pressed = true; b1PressStart = now; b1LongTriggered = false;
      if (currentAppMode == MODE_GAME) {
        if (!gameActive && !gameOver) { gameActive = true; gameScore = 0; obstacleX = 128; petY = 38; playSound("JUMP"); } 
        else if (gameActive && petY == 38) { petVY = -7; playSound("JUMP"); }
      }
    } else if (!b1LongTriggered && (now - b1PressStart >= 2500)) {
      b1LongTriggered = true; b1ClickCount = 0; playSound("SLEEP"); delay(800); enterDeepSleep();
    }
  } else {
    if (isB1Pressed) {
      isB1Pressed = false;
      if (!b1LongTriggered) { if (currentAppMode != MODE_GAME || gameOver) { b1ClickCount++; lastB1Time = now; } }
    }
  }

  if (b1ClickCount > 0 && (now - lastB1Time > 350)) {
    if (b1ClickCount == 2) {
      if (gameOver) { gameOver = false; gameActive = true; gameScore = 0; obstacleX = 128; petY = 38; playSound("JUMP"); } 
      else if (currentState == SICK) curePet(); else triggerFeed();
    } 
    else if (b1ClickCount == 1) {
      if (currentAppMode == MODE_PET) triggerWink();
      else if (currentAppMode == MODE_POMODORO) { pomodoroRunning = !pomodoroRunning; playSound("HAPPY"); }
      else if (currentAppMode == MODE_QUOTE) { currentQuoteIdx = random(0, 5); playSound("WAKE"); }
      else if (currentAppMode == MODE_8BALL) { current8BallIdx = random(0, 6); playSound("JUMP"); }
      else if (currentAppMode == MODE_PONG) { pongPlayerMovingUp = !pongPlayerMovingUp; playSound("JUMP"); } 
      else if (currentAppMode == MODE_PROMPTER || currentAppMode == MODE_MSG) { currentAppMode = MODE_PET; playSound("HAPPY"); } 
    }
    b1ClickCount = 0;
  }

  // --- TOMBOL 2 (MODE) ---
  int b2State = digitalRead(BUTTON2_PIN);
  if (b2State == LOW) {
    if (!isB2Pressed) { isB2Pressed = true; b2PressStart = now; b2LongTriggered = false; } 
    else if (!b2LongTriggered && (now - b2PressStart >= 1000)) {
      b2LongTriggered = true; currentAppMode = MODE_PET; playSound("HAPPY");
    }
  } else {
    if (isB2Pressed) {
      isB2Pressed = false;
      if (!b2LongTriggered) { currentAppMode = (AppMode)((currentAppMode + 1) % 13); playSound("WAKE"); }
    }
  }
}


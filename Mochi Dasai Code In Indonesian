void setupWebServer() {
  server.onNotFound([]() {
    if (server.method() == HTTP_OPTIONS) {
      server.sendHeader("Access-Control-Allow-Origin", "*");
      server.sendHeader("Access-Control-Allow-Methods", "GET, POST, OPTIONS");
      server.sendHeader("Access-Control-Allow-Headers", "*");
      server.sendHeader("Access-Control-Allow-Private-Network", "true");
      server.send(204);
    } else {
      server.send(404, "text/plain", "Not Found");
    }
  });

  server.on("/", []() { 
    server.sendHeader("Access-Control-Allow-Origin", "*");
    server.send(200, "text/html", HTML_PAGE); 
  });
  
  server.on("/api/status", []() {
    server.sendHeader("Access-Control-Allow-Origin", "*");
    server.sendHeader("Access-Control-Allow-Private-Network", "true");
    
    String json = "{";
    json += "\"state\":\"" + getStateString() + "\",";
    json += "\"level\":" + String(petLevel) + ",";
    json += "\"title\":\"" + evolutionTitle + "\",";
    json += "\"temp\":" + String(currentTemp) + ",";
    json += "\"hunger\":" + String(hungerLevel);
    json += "}";
    server.send(200, "application/json", json);
  });

  server.on("/feed", []() { server.sendHeader("Access-Control-Allow-Origin", "*"); triggerFeed(); server.send(200, "text/plain", "OK"); });
  server.on("/wink", []() { server.sendHeader("Access-Control-Allow-Origin", "*"); triggerWink(); server.send(200, "text/plain", "OK"); });
  server.on("/shock", []() { server.sendHeader("Access-Control-Allow-Origin", "*"); triggerShocked(); server.send(200, "text/plain", "OK"); });
  server.on("/toggle_pomo", []() { server.sendHeader("Access-Control-Allow-Origin", "*"); pomodoroRunning = !pomodoroRunning; server.send(200, "text/plain", "OK"); });
  server.on("/deepsleep", []() { server.sendHeader("Access-Control-Allow-Origin", "*"); enterDeepSleep(); });
  
  server.on("/set_gps", []() {
    server.sendHeader("Access-Control-Allow-Origin", "*");
    if (server.hasArg("lat") && server.hasArg("lon")) {
      currentLat = server.arg("lat").toFloat(); currentLon = server.arg("lon").toFloat();
      fetchWeather(); currentAppMode = MODE_GPS; playSound("WAKE"); server.send(200, "text/plain", "OK");
    } else server.send(400, "text/plain", "Error");
  });
  
  server.on("/set_prompter", []() {
    server.sendHeader("Access-Control-Allow-Origin", "*");
    if (server.hasArg("text")) { currentPrompterLine = server.arg("text"); currentAppMode = MODE_PROMPTER; server.send(200, "text/plain", "OK"); } else server.send(400, "text/plain", "Error");
  });

  server.on("/send_msg", []() {
    server.sendHeader("Access-Control-Allow-Origin", "*");
    if (server.hasArg("text")) {
      incomingMsg = server.arg("text"); currentAppMode = MODE_MSG; playSound("ALARM"); server.send(200, "text/plain", "OK");
    } else server.send(400, "text/plain", "Error");
  });
}

void setup() {
  Serial.begin(115200); 
  pinMode(BUTTON1_PIN, INPUT_PULLUP); 
  pinMode(BUTTON2_PIN, INPUT_PULLUP); 
  pinMode(LED_PIN, OUTPUT); 
  ledcAttach(BUZZER_PIN, 100, 13);
  randomSeed(analogRead(0));
  for(int i=0; i<16; i++) matrixY[i] = random(0, 64);

  loadPreferencesData();
  initOLED(); display.clearDisplay(); display.setTextSize(1); display.setTextColor(OLED_COLOR_WHITE);
  display.setCursor(10, 24); display.print("Connecting WiFi..."); safeDisplayRender();

  WiFi.setTxPower(WIFI_POWER_8_5dBm); WiFi.begin(wifiSSID.c_str(), wifiPASS.c_str());
  unsigned long start = millis(); while (WiFi.status() != WL_CONNECTED && millis() - start < 8000) delay(200);

  setupWebServer(); server.begin();
  if (WiFi.status() == WL_CONNECTED) { 
    isOnline = true; WiFi.mode(WIFI_STA); configTime(gmtOffset_sec, daylightOffset_sec, ntpServer); MDNS.begin("cyberpet"); 
    Serial.println("");
    Serial.println("WIFI CONNECTED!");
    Serial.print("IP Address: ");
    Serial.println(WiFi.localIP());
  } 
  else { 
    isOnline = false; WiFi.mode(WIFI_AP); WiFi.softAP("CyberPet_Setup"); delay(4000); 
  }

  lastInteractionTime = millis(); lastHungerDecay = millis(); stateTimer = millis(); lastTimeUpdate = millis(); resetPongBall();
}

void loop() {
  updateTime(); checkNightMode();
  unsigned long currentMillis = millis();

  if (isOnline) {
    server.handleClient();
    if (currentMillis - lastWeatherUpdate > WEATHER_INTERVAL) { fetchWeather(); lastWeatherUpdate = currentMillis; }
  } else server.handleClient();

  handleButtons(); 
  updatePomodoro(); updateGameLogic(); updatePongLogic();

  if (currentState == HAPPY || currentState == SHOCKED || currentState == WINK || currentState == LEVEL_UP_STATE) {
    if (currentMillis - stateTimer > 3000) currentState = IDLE;
  }
  
  if (currentMillis - lastHungerDecay > 180000) {
    lastHungerDecay = currentMillis;
    if (hungerLevel > 0) hungerLevel -= 5;
    if (hungerLevel <= 30) playSound("BEEP"); 
  }

  display.clearDisplay();
  switch (currentAppMode) {
    case MODE_PET: renderPetMode(currentMillis); break;
    case MODE_STATS: renderStatsMode(); break;
    case MODE_MEMENTO: renderMementoMode(); break;
    case MODE_POMODORO: renderPomodoroMode(); break;
    case MODE_GAME: renderGameMode(); break;
    case MODE_PONG: renderPongMode(); break;
    case MODE_QUOTE: renderQuoteMode(); break;
    case MODE_GPS: renderGPSMode(currentMillis); break;
    case MODE_8BALL: render8BallMode(); break;
    case MODE_PROMPTER: renderPrompterMode(); break;
    case MODE_WIFI: renderWifiMode(); break;
    case MODE_MATRIX: renderMatrixMode(); break;
    case MODE_MSG: renderMsgMode(); break;
  }
  safeDisplayRender(); delay(20);
}
